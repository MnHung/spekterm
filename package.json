{
  "name": "spekterm",
  "productName": "Spekterm",
  "desktopName": "spekterm.desktop",
  "version": "0.2.18",
  "private": true,
  "license": "MIT",
  "author": "Kewang",
  "description": "Spec-driven multi-agent development workbench (Electron desktop app)",
  "homepage": "https://github.com/spekhq/spekterm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spekhq/spekterm.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.spekterm.app",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map",
      "!out/licenses/**",
      "!out/THIRD_PARTY_LICENSES.txt"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "syncDesktopName": true,
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE"
        },
        {
          "from": "out/THIRD_PARTY_LICENSES.txt",
          "to": "THIRD_PARTY_LICENSES.txt"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "LICENSE",
          "to": "LICENSE"
        },
        {
          "from": "out/THIRD_PARTY_LICENSES.txt",
          "to": "THIRD_PARTY_LICENSES.txt"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "XDG_CONFIG_HOME=$HOME/.config/spekterm-dev electron-vite dev",
    "build": "electron-vite build && node scripts/third-party-licenses.mjs",
    "dist:linux": "node scripts/release-bump.mjs && npm run build && electron-builder --linux --publish never && node scripts/prune-release.mjs",
    "release:github": "node scripts/release-github.mjs",
    "dist:mac": "node scripts/release-check.mjs && npm ci && npm run build && node scripts/package-mac.mjs && node scripts/prune-release.mjs",
    "install:desktop": "node scripts/install-desktop.mjs",
    "uninstall:desktop": "node scripts/uninstall-desktop.mjs",
    "preview": "electron-vite preview",
    "probe:shell": "node scripts/run-probe.mjs shell",
    "probe:workspace": "node scripts/run-probe.mjs workspace",
    "probe:core": "node scripts/run-probe.mjs core",
    "probe:native": "node scripts/run-probe.mjs native",
    "probe:identity": "node scripts/run-probe.mjs identity",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test src/shared/*/*.test.ts src/main/*.test.ts src/main/*/*.test.ts src/renderer/src/shell/*.test.ts src/renderer/src/shell/*/*.test.ts scripts/*.test.mjs",
    "test:e2e": "npm run build && node scripts/run-probes.mjs",
    "test:all": "npm run test:unit && npm run test:e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "capture:screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "lint": "eslint .",
    "probe:files": "node scripts/run-probe.mjs files",
    "probe:terminal": "node scripts/run-probe.mjs terminal",
    "probe:keyboard": "node scripts/run-probe.mjs keyboard",
    "probe:openspec": "node scripts/run-probe.mjs openspec",
    "probe:insights": "node scripts/run-probe.mjs insights",
    "probe:agent-view": "node scripts/run-probe.mjs agent-view",
    "probe:intake": "node scripts/run-probe.mjs intake",
    "probe:slack": "node scripts/run-probe.mjs slack",
    "probe:remote": "node scripts/run-probe.mjs remote",
    "probe:package": "npm run dist:linux && node scripts/run-probe.mjs package",
    "probe:package:mac": "node scripts/probe-package-mac.mjs"
  },
  "devDependencies": {
    "@electron/get": "5.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "43.5.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "monaco-editor": "0.57.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.63.0",
    "uqr": "^0.1.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@spekjs/core": "^1.13.0",
    "@spekjs/ui": "^1.3.1",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/addon-serialize": "0.15.0-beta.299",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.299",
    "@xterm/addon-web-links": "0.13.0-beta.299",
    "@xterm/addon-webgl": "0.20.0-beta.298",
    "@xterm/xterm": "6.1.0-beta.302",
    "chokidar": "^5.0.0",
    "electron-updater": "6.8.9",
    "i18next": "^26.3.6",
    "node-pty": "1.2.0-beta.14",
    "ws": "^8.22.0"
  }
}
